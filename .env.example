# Copy this file to .env and fill in real values. Never commit .env.

# Sarvam AI API key (used to tailor resumes/cover letters/referral requests)
SARVAM_API_KEY=

# Google Drive file ID of the plain-text detailed resume (source of truth for tailoring)
DETAILED_RESUME_TXT_ID=

# Name of the Google Sheet workbook the 9AM job writes to (optional, defaults to "Job_Application_Tracker")
SPREADSHEET_NAME=Job_Application_Tracker
